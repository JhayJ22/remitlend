# See docs/ENVIRONMENT.md for full reference
# ── Required ─────────────────────────────────────────────────────────────────
# Backend API base URL — MUST be set in production.
# Missing this in production will cause a startup error.
# Example: https://api.remitlend.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── SEO & Metadata ───────────────────────────────────────────────────────────
# Site origin for canonical URLs, robots, sitemap, and OG tags
# Used across metadata.ts, robots.ts, sitemap.ts, and layout.tsx
# Default: https://remitlend.com (production)
NEXT_PUBLIC_APP_URL=https://remitlend.com

# ── Stellar Network ──────────────────────────────────────────────────────────
# Every value below must describe the SAME network. Mixing a testnet RPC with a
# mainnet passphrase produces signature errors that look like wallet problems.
#
# Soroban RPC endpoint used to simulate and submit contract calls.
# Testnet (default): https://soroban-testnet.stellar.org
# Mainnet:           https://soroban.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Horizon endpoint, used to resolve transaction error details.
# Testnet (default): https://horizon-testnet.stellar.org
# Mainnet:           https://horizon.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase the wallet signs against. Must match the RPC network above.
# Testnet (default): "Test SDF Network ; September 2015"
# Mainnet:           "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Service Health ───────────────────────────────────────────────────────────
# How often (ms) the DegradedServiceBanner polls /health and /status/pause.
# Default: 30000 (30 seconds). Set to 0 to disable polling entirely (e.g. E2E
# tests). See src/app/components/providers/ServiceStatusProvider.tsx.
NEXT_PUBLIC_SERVICE_HEALTH_POLL_MS=30000

# ── Contract Version ─────────────────────────────────────────────────────────
# Selects which Soroban contract ABI version the frontend targets.
# Supported values: "v1" (default, matches all currently deployed contracts),
#                   "v2" (next-generation interface — gate with isContractV2()).
# Leave unset (or set to "v1") for production until the v2 contracts are fully
# deployed and verified. Change to "v2" for staging environments targeting
# the updated contracts. A rollback is a one-env-var change + rebuild.
# See src/app/utils/contractVersion.ts for implementation details.
NEXT_PUBLIC_CONTRACT_VERSION=v1

# ── Contract IDs ─────────────────────────────────────────────────────────────
# Deployed Soroban contract addresses. Each is a 56-character strkey beginning
# with "C" — the value `soroban contract deploy` prints, and network-specific:
# a testnet ID will not resolve against mainnet RPC.
# Example: CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
#
# Lending pool manager — deposits, withdrawals, and pool state.
# Canonical name; mirrors the backend's LENDING_POOL_CONTRACT_ID.
# (The old NEXT_PUBLIC_MANAGER_CONTRACT_ID is still read as a fallback.)
NEXT_PUBLIC_LENDING_POOL_CONTRACT_ID=

# Loan manager — loan origination, repayment, and liquidation.
NEXT_PUBLIC_LOAN_MANAGER_CONTRACT_ID=

# Remittance NFT — mints the receipt NFT for a remittance.
NEXT_PUBLIC_NFT_CONTRACT_ID=

# ── Sentry Configuration ──────────────────────────────────────────────────────
# Browser-side Sentry DSN. Exposed to the client by design; leave blank to
# disable error reporting in local development.
# Example: https://<key>@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=

# Server-side Sentry DSN. Usually the same value as the public DSN above.
SENTRY_DSN=

# Sentry organisation slug, used at build time to upload source maps.
SENTRY_ORG=

# Sentry project slug, used at build time to upload source maps.
SENTRY_PROJECT=

# Sentry auth token for source-map upload. Build-time only — never exposed to
# the browser. Leave blank locally; set it in CI.
SENTRY_AUTH_TOKEN=

# Node environment. `development` locally, `production` for a deployed build.
NODE_ENV=development

# Stellar Explorer base URL (no trailing slash)
# Mainnet: https://stellar.expert/explorer/public
# Testnet: https://stellar.expert/explorer/testnet (default)
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet
